# Copy to backend/automation/.env (gitignored) to get a Telegram DM after weekly runs.
# Optional — the weekly run works without it. Uses the same bot as the channel alerts.
#   TELEGRAM_BOT_TOKEN       from @BotFather
#   TELEGRAM_OWNER_CHAT_ID   your own chat id (message the bot once, then see docs/AUTOMATION.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
